#!/usr/bin/env bash

set -euo pipefail

version=v0.70.1

case "${RUNNER_OS:?}:${RUNNER_ARCH:?}" in
  Linux:X64)
    asset=pixi-x86_64-unknown-linux-musl
    expected_digest=6d51531f4ae7b83fe68e72fe0935ed192e7f8e2eb04e3c4cd45f03a24f217ac6
    ;;
  Linux:ARM64)
    asset=pixi-aarch64-unknown-linux-musl
    expected_digest=fde0055bb7a170f23b9efc4f01430003c2a17dcad0a34784eff0263a1bf4bc1d
    ;;
  macOS:X64)
    asset=pixi-x86_64-apple-darwin
    expected_digest=212e94bc5525c255961c29c9129e983120e5ecb48ed52192481dcc3acec4b2bd
    ;;
  macOS:ARM64)
    asset=pixi-aarch64-apple-darwin
    expected_digest=f6e3efb67d5d6d8ea1c91304e523717fba55d7f7e090d433ec246e2e317a5fbd
    ;;
  Windows:X64)
    asset=pixi-x86_64-pc-windows-msvc.exe
    expected_digest=270742c85a1d51461b038ad38bebf670f240880ebe15c98e44810ed090a6b408
    ;;
  Windows:ARM64)
    asset=pixi-aarch64-pc-windows-msvc.exe
    expected_digest=cd8b47b1a2adce67c4dce9f8413f7e3e5c16e3e59de8e0079fa5d5fba17a6b9d
    ;;
  *)
    echo "Unsupported GitHub runner: ${RUNNER_OS}:${RUNNER_ARCH}" >&2
    exit 1
    ;;
esac

umask 077
runner_temp="${RUNNER_TEMP:?}"
if [[ "${RUNNER_OS}" == Windows ]]; then
  runner_temp="$(cygpath --unix "${runner_temp}")"
fi
install_dir="$(mktemp -d "${runner_temp%/}/conda-presto-pixi.XXXXXX")"
download="${install_dir}/${asset}.download"
binary="${install_dir}/pixi"
if [[ "${RUNNER_OS}" == Windows ]]; then
  binary="${binary}.exe"
fi

curl --disable --fail --location --silent --show-error \
  --proto '=https' \
  --proto-redir '=https' \
  --connect-timeout 10 \
  --max-time 120 \
  --output "${download}" \
  "https://github.com/prefix-dev/pixi/releases/download/${version}/${asset}"

actual_digest="$(PIXI_DOWNLOAD="${download}" node - <<'JS'
const crypto = require("node:crypto")
const fs = require("node:fs")

const digest = crypto
  .createHash("sha256")
  .update(fs.readFileSync(process.env.PIXI_DOWNLOAD))
  .digest("hex")
process.stdout.write(digest)
JS
)"
if [[ "${actual_digest}" != "${expected_digest}" ]]; then
  rm -f "${download}"
  echo "Pixi download failed SHA-256 verification" >&2
  exit 1
fi

mv "${download}" "${binary}"
chmod 0755 "${binary}"

path_entry="${install_dir}"
if [[ "${RUNNER_OS}" == Windows ]]; then
  path_entry="$(cygpath --windows "${install_dir}")"
fi
printf '%s\n' "${path_entry}" >> "${GITHUB_PATH:?}"
