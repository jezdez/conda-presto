#!/usr/bin/env bash

set -euo pipefail

: "${GH_REPO:?}"
: "${GITHUB_OUTPUT:?}"
: "${RELEASE_TAG:?}"

if [[ ! "${RELEASE_TAG}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Release tags must use vMAJOR.MINOR.PATCH" >&2
  exit 1
fi
if test "$(git cat-file -t "refs/tags/${RELEASE_TAG}")" != tag; then
  echo "Release tags must be annotated and signed" >&2
  exit 1
fi

tag_sha="$(gh api "repos/${GH_REPO}/git/ref/tags/${RELEASE_TAG}" --jq '.object.sha')"
tag_object="$(gh api "repos/${GH_REPO}/git/tags/${tag_sha}")"
if ! jq --exit-status '.verification.verified == true' <<<"${tag_object}" >/dev/null; then
  echo "GitHub could not verify the release tag signature" >&2
  exit 1
fi
if ! jq --arg tag "${RELEASE_TAG}" --exit-status '.tag == $tag' \
  <<<"${tag_object}" >/dev/null; then
  echo "Signed tag name does not match the release tag" >&2
  exit 1
fi
if ! jq --exit-status '.object.type == "commit"' <<<"${tag_object}" >/dev/null; then
  echo "Release tag must point directly to a commit" >&2
  exit 1
fi

tagged_commit="$(jq --raw-output '.object.sha' <<<"${tag_object}")"
if [[ ! "${tagged_commit}" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Release tag does not contain a valid commit digest" >&2
  exit 1
fi
if test "${tagged_commit}" != "$(git rev-parse "${RELEASE_TAG}^{commit}")"; then
  echo "Local and GitHub tag targets do not match" >&2
  exit 1
fi

git fetch --no-tags origin main:refs/remotes/origin/main
if ! git merge-base --is-ancestor "${tagged_commit}" origin/main; then
  echo "Release tag must point to a commit on main" >&2
  exit 1
fi

check_runs="$(gh api \
  "repos/${GH_REPO}/commits/${tagged_commit}/check-runs?filter=latest&per_page=100")"
for required_check in \
  "Lint" \
  "Test" \
  "Broker lifecycle" \
  "Analyze Python" \
  "Analyze GitHub Actions"; do
  if ! jq --arg name "${required_check}" --exit-status '
    [.check_runs[] | select(
      .name == $name and .app.slug == "github-actions"
    )] as $matches
    | ($matches | length) > 0
      and all($matches[];
        .status == "completed" and .conclusion == "success"
      )
  ' <<<"${check_runs}" >/dev/null; then
    echo "Required check did not pass: ${required_check}" >&2
    exit 1
  fi
done

{
  echo "commit=${tagged_commit}"
  echo "short_commit=${tagged_commit:0:7}"
} >> "${GITHUB_OUTPUT}"
