{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conda-presto-edge",
  "main": "src/entry.py",
  "compatibility_flags": ["python_workers"],
  "compatibility_date": "2026-09-13",
  "containers": [
    {
      "class_name": "PrestoContainer",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "image_vars": { "PIXI_ENVIRONMENT": "artifacts" },
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PRESTO", "class_name": "PrestoContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PrestoContainer"] }],
  "r2_buckets": [{ "binding": "RESULTS", "bucket_name": "conda-presto-results" }],
  "vars": {
    "CONDA_PRESTO_CHANNELS": "conda-forge",
    "CONDA_PRESTO_PLATFORMS": "linux-64"
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "dev": { "port": 8787 }
}
